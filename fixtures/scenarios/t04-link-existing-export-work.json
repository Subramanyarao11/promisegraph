{
  "id": "t04-link-existing-export-work",
  "acceptance_ids": [
    "T04"
  ],
  "workspace_id": "ws_demo",
  "description": "J3: 'Scheduled exports stopped working; we need them before Friday' for Acme. The graph shows existing blocked work, another affected request, a dependency, an owner and a prior failed workaround. The agent links once, keeps the request awaiting work, does not promise Friday and does not suggest Acme's forbidden public-link workaround.",
  "steps": [
    {
      "id": "s1",
      "action": "create_request",
      "input": {
        "customer_id": "customer_acme",
        "subject": "Scheduled exports stopped working",
        "body": "Our scheduled exports stopped working again this week. Finance needs the board pack exports before Friday. What is going on?",
        "channel": "manual",
        "capability_ids": [],
        "external_ref": null,
        "auto_start": true,
        "planner_mode": "scripted"
      }
    },
    {
      "id": "s2",
      "action": "await_run",
      "input": {
        "run_id": "${s1.run.id}",
        "until_status_in": [
          "succeeded",
          "awaiting_review",
          "waiting_for_input",
          "failed",
          "cancelled"
        ],
        "timeout_seconds": 90
      }
    },
    {
      "id": "s3",
      "action": "commit_proposal",
      "input": {
        "proposal_id": "${s2.proposal.id}",
        "idempotency_key": "scenario-t04-commit",
        "body": {
          "expected_revision": "${s2.proposal.based_on_revision}",
          "authorization_id": null
        }
      }
    },
    {
      "id": "s4",
      "action": "await_run",
      "input": {
        "run_id": "${s1.run.id}",
        "until_status_in": [
          "succeeded",
          "failed"
        ],
        "timeout_seconds": 90
      }
    },
    {
      "id": "s5",
      "action": "commit_proposal",
      "input": {
        "proposal_id": "${s2.proposal.id}",
        "idempotency_key": "scenario-t04-commit",
        "body": {
          "expected_revision": "${s2.proposal.based_on_revision}",
          "authorization_id": null
        }
      }
    },
    {
      "id": "s6",
      "action": "get_request",
      "input": {
        "request_id": "${s1.request.id}"
      }
    }
  ],
  "expectations": [
    {
      "assert": "run_status",
      "step": "s2",
      "values": [
        "awaiting_review"
      ]
    },
    {
      "assert": "proposal_kind",
      "step": "s2",
      "values": [
        "link_work"
      ]
    },
    {
      "assert": "proposal_payload_equals",
      "step": "s2",
      "path": "work_item_id",
      "value": "work_export_issue"
    },
    {
      "assert": "rejected_alternative_kind",
      "step": "s2",
      "kinds": [
        "create_work"
      ]
    },
    {
      "assert": "context_includes",
      "step": "s2",
      "field": "attempts",
      "ids": [
        "attempt_exports_001"
      ]
    },
    {
      "assert": "context_includes",
      "step": "s2",
      "field": "decisions",
      "ids": [
        "decision_exports_001"
      ]
    },
    {
      "assert": "context_includes",
      "step": "s2",
      "field": "related_work",
      "ids": [
        "work_export_issue",
        "work_export_migration"
      ]
    },
    {
      "assert": "text_not_matches",
      "step": "s2",
      "fields": [
        "explanation",
        "payload.comment_text"
      ],
      "regex": "(?i)(will|should) be (fixed|restored|ready|delivered|working)[^.]*(by|before) friday"
    },
    {
      "assert": "text_not_matches",
      "step": "s2",
      "fields": [
        "explanation",
        "payload.comment_text"
      ],
      "regex": "(?i)public (share )?link"
    },
    {
      "assert": "action_status",
      "step": "s4",
      "values": [
        "succeeded"
      ]
    },
    {
      "assert": "action_verification",
      "step": "s4",
      "values": [
        "pending"
      ]
    },
    {
      "assert": "run_status",
      "step": "s4",
      "values": [
        "succeeded"
      ]
    },
    {
      "assert": "same_id",
      "a": "${s5.action.id}",
      "b": "${s3.action.id}"
    },
    {
      "assert": "request_status",
      "step": "s6",
      "values": [
        "awaiting_work"
      ]
    },
    {
      "assert": "request_linked_work_equals",
      "step": "s6",
      "ids": [
        "work_export_issue"
      ]
    },
    {
      "assert": "work_item_count_delta",
      "step": "s6",
      "value": 0
    }
  ]
}
